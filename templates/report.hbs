{{#each reports}}
<a href="{{this.url}}" class="report-link">
    <div class="report-card-container" report-id="{{this.report_id}}">
        <i class="fas fa-file-alt"></i>
        <span class="report-title">{{this.title}}</span>
        <i class="report-edit-icon fas fa-ellipsis-v"></i>
    </div>
</a>
{{/each}}
