<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/line.css">
    <link rel="stylesheet" href="/css/notification.css">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/dropdown-menu.css">
    <link rel="stylesheet" href="/css/header-footer.css">
    <title>Document</title>
</head>
<body> 
    <div class="wrapper">
        <header class="site-header">
            <div class="logo-container">
                <i class="uil uil-graduation-cap site-logo"></i>
            </div>
            
            <button class="menu-toggle" aria-label="Toggle navigation">
                <i class="uil uil-bars"></i>
            </button>

            <nav class="navigation">
                <ul class="nav-links">
                    <li><a href="/" class="nav-link"><i class="uil uil-estate"></i> Home</a></li>
                    <li><a href="/profile" class="nav-link"><i class="uil uil-user-circle"></i> Profile</a></li>
                    <li><a href="/auth/logout" class="nav-link"><i class="uil uil-signout"></i> Logout</a></li>
                </ul>
            </nav>
        </header>


        <main class="main-content">
            <div class="homeworks-groups-tittle-contains">
                <h1 class="page-title">Homework groups</h1>
            </div> 
            <div class="card-group-container">
                {{#each homeworkWithUrls}}
                    <div class="homework-card-container", data-id="{{this.homework_id}}">
                        <a href="{{this.url}}" class="homework-card-link">
                            <div class="homework-card-header" style="background-color: {{this.card_color}}">
                                <i class="uil uil-ellipsis-v homework-card-edit-icon"></i>
                            </div>
                            <div class="homework-card-footer">
                                <h2 class="homework-card-title">{{this.title}}</h2>
                            </div>
                        </a>   
                    </div>
                {{/each}}

                <div class="homework-card-container add-card">
                    <a href="javascript:void(0);" class="homework-card-link" id="add-homework-card">
                        <div class="homework-card-footer add-footer">
                            <i class="uil uil-plus homework-card-title plus-icon"></i>
                        </div>
                    </a>
                </div>

                 <div id="create-card-modal" class="create-card-modal">
                    <div class="modal-content">
                        <span class="close">&times;</span>
                        <input type="text" id="homework-name" class="input-field" placeholder="Report Name" />
                        <p class="notification-message" id="notification-homework-message"></p>
                        <button class="button" id="submit-btn-homework-modal">Create</button>
                    </div>
                </div>

                <div id="delete-confirmation-modal" class="delete-confirmation-modal">
                    <div class="modal-content">
                        <span class="close" id="close-delete-modal">&times;</span> <p id="delete-message">Are you sure you want to delete this group?</p>
                        <div class="model-footer">
                            <button id="confirm-delete-btn" class="button">Yes</button>
                            <button id="cancel-delete-btn" class="button">No</button>
                        </div>
                    </div>
                </div>

                <div class="option-modal-overlay" id="option-modal">
                    <div class="option-modal-content">
                        <span class="close" id="option-modal-close">&times;</span>
                        <ul>
                            <li id="edit-option">Edit</li>
                            <li id="delete-option">Delete</li>
                        </ul>
                    </div>
                </div>

                <div id="informational-modal" class="informational-modal error">
                    <div id="informational-modal-content" class="informational-modal-content">
                        <span id="close-informational-modal" class="close-informational-modal">&times;</span>
                        <h2 id="informational-modal-title" class="informational-modal-title"></h2>
                        <p id="informational-modal-text-content" class="informational-modal-text-content"></p>
                        <button id="close-informational-modal-btn" class="close-informational-modal-btn">Close</button>
                    </div>
                </div>
            </div>
        </main>
        <footer class="site-footer">
            <p>&copy; 2025 Auto Assess Platform. All rights reserved.</p>
        </footer>
    </div>
    <script src="/js/mobileMenu.js"></script>
    <script src="/js/homeworkModalHandler.js"></script>
</body>
</html>

