<!DOCTYPE html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Report</title>
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/line.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.css">
    <script src="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <link rel="stylesheet" href="/css/header-footer.css">
    <link rel="stylesheet" href="/css/report-editor.css">
    <link rel="stylesheet" href="/css/prism.css">
    
</head>
<body>

    <header class="site-header">
      <div class="logo-container">
          <i class="uil uil-graduation-cap site-logo"></i>
      </div>
      
      <button class="menu-toggle" aria-label="Toggle navigation">
          <i class="uil uil-bars"></i>
      </button>

      <nav class="navigation">
          <ul class="nav-links">
              <li><a href="/" class="nav-link"><i class="uil uil-estate"></i> Home</a></li>
              <li><a href="/save" class="nav-link"><i class="uil uil-save"></i> Save</a></li>
              <li><a href="/send" class="nav-link"><i class="uil uil-message"></i> Send</a></li>
          </ul>
      </nav>
  </header> 

    <div class="editor-container">
      <textarea id="editor" class="editor">{{report-content}}</textarea>
      <div id="preview" class="markdown-body"></div>
    </div>
    <script src="/js/prism.js"></script>
    <script src="/js/mobileMenu.js"></script>
    <script src="/js/markdownEditor.js"></script>
</body>
</html>
