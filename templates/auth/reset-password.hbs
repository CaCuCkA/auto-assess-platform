<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/auth-style.css">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/line.css">
    <title>Reset Password</title>
</head>
<body>

    <div class="form-container">
        <h2 class="form-title">Reset Your Password</h2>

        <form action="/reset-password" id="sending-form" method="POST">
            
            <input type="hidden" name="token" value="{{token}}" />
            
            <div class="input-field">
                <i class="uil uil-lock password-icon"></i>
                <i class="uil uil-eye-slash password-toggle-icon"></i>
                <input 
                    type="password" 
                    name="password" 
                    class="password-input" 
                    id="password" 
                    required 
                    placeholder="Enter your new password"
                />
            </div>
            <p class="warning-message" id="password-warning-message"></p>

            <div class="input-field">
                <i class="uil uil-lock password-icon"></i>
                <input 
                    type="password" 
                    name="confirm-password" 
                    class="password-input" 
                    id="confirm-password" 
                    required 
                    placeholder="Confirm your new password"
                />
            </div>
            <p class="error-message" id="password-error-message"></p>

            <button type="submit" class="button" id="submit-btn">Reset</button>
        </form>
    </div>

    <script src="/js/togglePasswordVisibility.js"></script>
    <script src="/js/passwordValidation.js"></script>

</body>
</html>
